# ───────────────────────────────────────────────
# SantePontaNegra — Environment Variables Example
# ───────────────────────────────────────────────
# Copy this file to `.env` for local development
# and configure the same variables on Vercel.
# NEVER commit your real `.env` file.

# Database URL
# Local dev (SQLite): file:./db/custom.db
# Production (recommended): PostgreSQL connection string from Neon / Supabase / Vercel Postgres
DATABASE_URL="file:./db/custom.db"

# JWT secret for session tokens (generate a long random string)
# Example: openssl rand -base64 32
JWT_SECRET="replace-me-with-a-long-random-secret"

# Public app URL (used for SEO, sitemap, OG metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: enable verbose Prisma logs in development
# PRISMA_LOG_QUERY="true"
