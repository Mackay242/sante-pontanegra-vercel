# ───────────────────────────────────────────────
# SantePontaNegra — Environment Variables Example
# ───────────────────────────────────────────────
# Copy this file to `.env` for local development
# and configure the same variables on Vercel.
# NEVER commit your real `.env` file.

# ── Database ───────────────────────────────────
# Local dev (SQLite): file:./db/custom.db
# Production (recommended): PostgreSQL connection string from Neon / Supabase / Vercel Postgres
# Example PostgreSQL: postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="file:./db/custom.db"

# ── Authentication ─────────────────────────────
# JWT secret for session tokens (generate a long random string)
# Example: openssl rand -base64 32
JWT_SECRET="replace-me-with-a-long-random-secret"

# ── Public URL ─────────────────────────────────
# Used for SEO, sitemap, OG metadata, push notifications
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI Chat (optional) ────────────────────────
# When unset, the chat médecin falls back to a rule-based bot.
# When set to "true", uses z-ai-web-dev-sdk for real LLM responses.
ENABLE_LLM_CHAT="false"

# ── Push Notifications (optional) ─────────────
# Generate VAPID keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# ── Debug ──────────────────────────────────────
# Optional: enable verbose Prisma logs in development
# PRISMA_LOG_QUERY="true"
