<?xml version="1.0" encoding="utf-8"?>
<!--
  Santé Pontanegra — App icon (vector drawable)
  Green gradient background + white heart
  Works on ALL Android versions (5+), no PNG dependency
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    
    <!-- Background: solid green (fallback for gradient — vectors don't support gradients easily) -->
    <path
        android:fillColor="#0d7a5f"
        android:pathData="M0,0 H512 V512 H0 Z" />
    
    <!-- Heart: white, centered -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M256,416 C200,380 144,340 144,272 C144,232 176,200 216,200 C240,200 261,212 256,232 C261,212 272,200 296,200 C336,200 368,232 368,272 C368,340 312,380 256,416 Z" />
</vector>
